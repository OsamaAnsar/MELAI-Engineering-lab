# Copy to .env and fill in. Never commit .env.

# --- apps/api ---
API_PORT=4000

# DB_DRIVER=pglite -> in-process PGlite DB, no Docker (packages/database/.pglite).
# DB_DRIVER=postgres -> use DATABASE_URL (docker-compose or a hosted Postgres).
DB_DRIVER=pglite
DATABASE_URL=postgres://melai:melai@localhost:5432/melai

# Provider keys (only apps/api reads these; the web app never does).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Local models
OLLAMA_BASE_URL=http://localhost:11434

# --- apps/web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
